# Generate a strong local service token; this is not an external provider API key.
IBVAP_API_TOKEN=replace-with-a-long-random-secret

# Mount separately licensed YOLOv8 ONNX weights at these locations.
# Person/vehicle model: COCO 80-class raw YOLOv8 output, no embedded NMS.
IBVAP_PERSON_VEHICLE_MODEL=models/yolov8n.onnx
# Plate model: one-class raw YOLOv8 output (class 0 = license_plate), no embedded NMS.
IBVAP_PLATE_MODEL=models/license-plate-yolov8.onnx
# Optional override; OpenCV's bundled Haar cascade is used otherwise.
# IBVAP_FACE_CASCADE_PATH=models/haarcascade_frontalface_default.xml
IBVAP_INFERENCE_PROVIDER=CPUExecutionProvider
IBVAP_INFERENCE_SIZE=640
IBVAP_CONFIDENCE_THRESHOLD=0.35
IBVAP_NMS_THRESHOLD=0.45
IBVAP_ANPR_MIN_OCR_CONFIDENCE=0.5
# Indian registration format by default; customize for another jurisdiction.
IBVAP_PLATE_PATTERN=^[A-Z]{2}[0-9]{1,2}[A-Z]{0,3}[0-9]{1,4}$
IBVAP_PROCESS_FPS=5

# Camera/event state
IBVAP_DATABASE_PATH=data/events.sqlite3
IBVAP_EVENT_RETENTION_DAYS=30
IBVAP_ALLOW_FILE_SOURCES=false
IBVAP_EVENT_COOLDOWN_SECONDS=30
IBVAP_LOITER_SECONDS=30

# Night window is interpreted in UTC in this baseline.
IBVAP_NIGHT_START_HOUR=20
IBVAP_NIGHT_END_HOUR=6

# Optional full path when Tesseract is not discoverable on PATH.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
